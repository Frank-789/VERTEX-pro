# 后端 API 地址（开发环境填 localhost，部署后填 Render 地址）
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# DeepSeek API Key（首选 - 用于策划方案生成）
NEXT_PUBLIC_DEEPSEEK_API_KEY=sk-1b1de9af40cb41eeaea80fca0861b5e7

# Kimi AI API Key（次选 - 当 DeepSeek 不可用时的备选）
# 到 https://platform.moonshot.cn/console 获取
NEXT_PUBLIC_KIMI_API_KEY=

# 图片生成 API 配置（兼容 OpenAI 格式，如 DALL-E 3、Stable Diffusion 等）
# 如果使用 OpenAI: IMAGE_API_BASE_URL=https://api.openai.com
# 如果使用 Stable Diffusion: IMAGE_API_BASE_URL=你的SD服务地址
NEXT_PUBLIC_IMAGE_API_BASE_URL=
NEXT_PUBLIC_IMAGE_API_KEY=
NEXT_PUBLIC_IMAGE_MODEL=
