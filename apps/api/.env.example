# DeepSeek API Configuration（首选 — 用于图片策划方案生成）
DEEPSEEK_API_KEY=sk-1b1de9af40cb41eeaea80fca0861b5e7
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Kimi AI API Configuration（次选 — DeepSeek 不可用时自动降级）
# 到 https://platform.moonshot.cn/console 获取
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn

# Server Configuration
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# === Data Crawler Configuration ===

# Oxylabs Realtime API (for 1688, SHEIN scraping)
# 到 https://dashboard.oxylabs.io/ 获取
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
OXYLABS_API_URL=https://realtime.oxylabs.io/v1/queries

# Apify Token (for Apify Actor-based scraping)
# 到 https://console.apify.com/ 获取
APIFY_TOKEN=
APIFY_DEFAULT_ACTOR=

# eBay Data API (for product search)
# 到 https://developer.ebay.com/ 获取
EBAY_API_KEY=
